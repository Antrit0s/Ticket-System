  "ticketMessages": [
    {
      "id": "tm1",
      "ticketId": "t1",
      "senderId": "u1",
      "text": "The screen flickers constantly and sometimes goes black for a few seconds.",
      "createdAt": "2026-09-19T09:05:00Z"
    },
    {
      "id": "tm2",
      "ticketId": "t3",
      "senderId": "u1",
      "text": "My external monitor shuts down every 10 minutes during calls.",
      "createdAt": "2026-09-19T10:05:00Z"
    },
    {
      "id": "tm3",
      "ticketId": "t3",
      "senderId": "a1",
      "text": "Could you confirm the cable type and whether it also happens on battery?",
      "createdAt": "2026-09-19T10:12:00Z"
    },
    {
      "id": "tm4",
      "ticketId": "t3",
      "senderId": "u1",
      "text": "It's DisplayPort and it happens even when plugged in. I've attached the error log.",
      "createdAt": "2026-09-19T10:20:00Z",
      "attachment": "monitor-error.log"
    },
    {
      "id": "tm5",
      "ticketId": "t3",
      "senderId": "a1",
      "text": "Thanks — I've scheduled a desk visit for tomorrow morning.",
      "createdAt": "2026-09-19T11:30:00Z"
    },
    {
      "id": "tm6",
      "ticketId": "t5",
      "senderId": "u2",
      "text": "The P3 color profile resets every time the display wakes from sleep.",
      "createdAt": "2026-09-21T11:05:00Z"
    },
    {
      "id": "tm7",
      "ticketId": "t5",
      "senderId": "a1",
      "text": "Which firmware version is currently running on the display?",
      "createdAt": "2026-09-21T11:45:00Z"
    },
    {
      "id": "tm8",
      "ticketId": "t6",
      "senderId": "u3",
      "text": "The USB-C contact is loose and it disconnects during IAM auth.",
      "createdAt": "2026-09-22T08:20:00Z"
    },
    {
      "id": "tm9",
      "ticketId": "t6",
      "senderId": "u3",
      "text": "Here's a short clip of the issue happening.",
      "createdAt": "2026-09-22T08:22:00Z",
      "attachment": "yubikey-issue.mp4"
    },
    {
      "id": "tm10",
      "ticketId": "t7",
      "senderId": "u4",
      "text": "Battery runtime drops below 40 minutes and the OS shows 'Service Battery'.",
      "createdAt": "2026-09-23T07:50:00Z"
    },
    {
      "id": "tm11",
      "ticketId": "t7",
      "senderId": "a1",
      "text": "I've ordered a replacement battery module and booked an appointment for you.",
      "createdAt": "2026-09-23T08:30:00Z"
    },
    {
      "ticketId": "t6",
      "senderId": "u1",
      "text": "hi",
